# Copy this file to .env and fill in real values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Required
API_KEY=
HMAC_SECRET=

# Optional — enables POST /anchor (publishes the latest hash as a GitHub commit)
GITHUB_TOKEN=
ANCHOR_REPO_OWNER=
ANCHOR_REPO_NAME=
